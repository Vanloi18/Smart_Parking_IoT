# SMART PARKING IoT - ENVIRONMENT EXAMPLE
PORT=5000
HOST=0.0.0.0
# Tạo riêng mỗi khóa: python -c "import secrets; print(secrets.token_hex(32))"
# Thay các giá trị giả dưới đây bằng hai khóa riêng trước khi sử dụng.
# Nếu thiếu hoặc để trống, khóa tạm đổi mỗi lần chạy: người dùng bị đăng xuất.
SECRET_KEY=CHANGE_ME_SECRET_KEY
JWT_SECRET=CHANGE_ME_JWT_SECRET
DATABASE_PATH=parking.db
UPLOAD_FOLDER=uploads
DEBUG=False

# Hạn dùng lệnh chụp camera (giây), phải lớn hơn 0.
CAMERA_COMMAND_TTL_SECONDS=60

# Tesseract Windows; không cần sửa .env nếu dùng đường dẫn cài mặc định này.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_MIN_CONFIDENCE=0.70
